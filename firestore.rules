rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    //
    // Collection: attendance
    // Fields: id, empId, date, status, checkIn, checkOut
    //
    // Collection: leaves
    // Fields: id, empId, type, from, to, status, reason
    //
    // Collection: advances
    // Fields: id, empId, amount, date, status, reason, isPaid
    //
    // Collection: targets
    // Fields: id, empId, month, category, targetCount, achievedCount
    //
    // Collection: auditLogs
    // Fields: id, timestamp, user, action, details, type
    //
    // Collection: settings
    // Fields: companyName, companySubtitle, fuelPrice, leavePolicy, workSchedule, theme
    //
    // Collection: paidDeductions
    // Fields: months
    //
    // Collection: credentials
    // Fields: empId, username, password, isAdmin
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    // match /{document=**} {
    //   allow read, write: if request.auth != null && 'email' in request.auth.token && request.auth.token.email == "zioncommercialcreditampara@gmail.com";
    // }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && 
        request.auth.token != null &&
        'email' in request.auth.token && 
        request.auth.token.email == "zioncommercialcreditampara@gmail.com";
    }

    function isAdmin() {
      return isMasterAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(empId) {
      return isAuthenticated() && empId != null && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'empId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empId == empId)
      );
    }

    function isValidAttendance(data) {
      return data.empId is string && data.date is string && data.status in ['Present', 'Absent', 'Late', 'Leave', 'Half Day'];
    }

    function canReadEmployee(empId, docData) {
      return isAdmin() || isOwner(empId) || (
        docData != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        'viewableBranches' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        'branch' in docData &&
        (
          'ALL' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableBranches ||
          docData.branch in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableBranches
        )
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /employees/{empId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isOwner(empId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePic', 'passkeyRawId']) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['passkeyRawId']) || !('passkeyRawId' in resource.data) || resource.data.passkeyRawId == '' || resource.data.passkeyRawId == null))
      );
      allow create, delete: if isAdmin();
    }

    function isBranchManager() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        'viewableBranches' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableBranches.size() > 0;
    }

    match /attendance/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidAttendance(request.resource.data);
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isBranchManager();
    }

    match /leaves/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /advances/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /cashRequests/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /targets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /performanceAllowances/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isAdminWithAllBranches() {
      return isAdmin() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        'viewableBranches' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
        (
          'ALL' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableBranches ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.viewableBranches.size() == 0
        );
    }

    function validAsset(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.category in ['Laptop', 'Desktop', 'Phone', 'Vehicle', 'Tablet', 'Printer', 'Other']
        && data.status in ['New', 'Good', 'Used', 'Bad', 'Broke']
        && data.branch is string && data.branch.size() > 0
        && data.addedBy is string
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /assets/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && validAsset(request.resource.data);
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payrollReceipts/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isMasterAdmin();
    }

    match /paidDeductions/{empId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /leaveBalances/{empId} {
      allow read: if isAuthenticated() && (isOwner(empId) || isAdmin());
      allow write: if isAdmin();
    }

    match /credentials/{username} {
      allow get: if isAuthenticated();
      allow list, write: if isAdmin();
    }

    match /test/{id} {
      allow read: if true;
    }
    
    match /branches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /directory/{empId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /users2/{uid} {
      allow read, write: if true;
    }

    match /hello/{id} {
      allow read, write: if true;
    }

    match /adhocBonuses/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    function isMessageParticipant(data) {
      return isAuthenticated() && (
        isMasterAdmin() ||
        (
          'participants' in data &&
          data.participants is list &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          'empId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          data.participants.hasAny([get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empId])
        )
      );
    }

    function isValidMessage(data) {
      return data.senderId is string &&
        data.participants is list &&
        data.participants.size() > 0 &&
        data.participants.size() <= 100 &&
        (isMasterAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          'empId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          data.senderId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.empId
        ));
    }

    match /messages/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isMessageParticipant(resource.data));
      allow create: if isAuthenticated() && isValidMessage(request.resource.data);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isMessageParticipant(resource.data)
      );
      allow delete: if isAdmin();
    }

    match /customNets/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /dcCollections/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.empId);
      allow update: if isAuthenticated() && (isAdmin() || isBranchManager());
      allow delete: if isMasterAdmin();
    }

    match /systemReports/{id} {
      allow read: if isMasterAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isMasterAdmin();
    }

    match /fileChunks/{id} {
      allow read, write: if isAuthenticated();
    }
  }
}
